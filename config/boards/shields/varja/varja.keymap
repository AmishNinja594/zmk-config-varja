#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h> // Required for USB/Bluetooth output toggles

/ {
    keymap {
        compatible = "zmk,keymap";

        // Layer 0: Your standard 9-key layout
        default_layer {
            bindings = <
                &kp N1 &kp N2 &kp N3 &kp N4 &none    // Top Row: 4 Keys + blank space for rotary encoder
                &kp N5 &kp N6 &kp N7 &kp N8 &mo 1    // Bottom Row: 4 Keys + layer toggle
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>; // Rotary Encoder behavior
        };

        // Layer 1: Bluetooth & Connection Utility (Active ONLY while holding the top-right key)
        utility_layer {
            bindings = <
                &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &trans       // Top Row: Select BT Profiles 1-4, Trans
                &out OUT_BLE &out OUT_USB &bt BT_CLR   &bt BT_CLR_ALL            // Bottom Row: Force BLE, Force USB, Clear Active Profile, Clear All
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
