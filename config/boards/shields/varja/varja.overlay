#include <zephyr/dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        label = "KSCAN";

        col-gpios
            = <&pro_micro 5 (GPIO_ACTIVE_HIGH)>  // COL0 -> P0.17
            , <&pro_micro 6 (GPIO_ACTIVE_HIGH)>  // COL1 -> P0.20
            , <&pro_micro 7 (GPIO_ACTIVE_HIGH)>  // COL2 -> P0.22
            , <&pro_micro 1 (GPIO_ACTIVE_HIGH)>  // COL3 -> P0.06
            , <&pro_micro 2 (GPIO_ACTIVE_HIGH)>  // COL4 -> P0.08
            ;

        row-gpios
            = <&pro_micro 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // ROW1 -> P0.24
            , <&pro_micro 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // ROW2 -> P1.00
            ;
    };

    encoder_1: encoder_1 {
        compatible = "alps,ec11";
        label = "ENCODER_1";
        a-gpios = <&pro_micro 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>; // P0.11
        b-gpios = <&pro_micro 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>; // P1.04
        steps = <80>;
        status = "okay";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder_1>;
    };
};
