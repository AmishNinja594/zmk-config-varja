#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        label = "KSCAN";

        col-gpios
            = <&gpio0 17 (GPIO_ACTIVE_HIGH)>  // COL0 -> P0.17
            , <&gpio0 20 (GPIO_ACTIVE_HIGH)>  // COL1 -> P0.20
            , <&gpio0 22 (GPIO_ACTIVE_HIGH)>  // COL2 -> P0.22
            , <&gpio0 6  (GPIO_ACTIVE_HIGH)>  // COL3 -> P0.06
            , <&gpio0 8  (GPIO_ACTIVE_HIGH)>  // COL4 -> P0.08
            ;

        row-gpios
            = <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // ROW1 -> P0.24
            , <&gpio1 0  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // ROW2 -> P1.00
            ;
    };

    encoder_1: encoder_1 {
        compatible = "alps,ec11";
        label = "ENCODER_1";
        a-gpios = <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>; // P0.11
        b-gpios = <&gpio1 4  (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>; // P1.04
        steps = <80>;
        status = "okay";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder_1>;
    };
};
